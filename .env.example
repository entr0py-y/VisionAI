# ==========================================
# VisionAI Backend Environment Configuration
# ==========================================

# OpenRouter AI (Primary LLM & Vision)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl

# Groq (Used for ultra-fast Speech-To-Text / Whisper)
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# NVIDIA (Optional direct access)
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/llama-3.1-nemotron-51b-instruct

# OpenAI (Optional fallback)
OPENAI_API_KEY=

# Supabase (Database & State)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-key

# Server Port
PORT=3000
